<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true"
    tools:context=".DetalleConsultaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/iv_header_detalle"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/sergaslogo" />

        <TextView
            android:id="@+id/tv_consulta_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="Consulta"
            android:textColor="#1A1C1E"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_consulta_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Resumen de la consulta enviada"
            android:textColor="#5F6368"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_motivo_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Motivo de consulta"
            android:textColor="#1A1C1E"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_consulta_motivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:text="Motivo"
            android:textColor="#333333"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_consulta_estado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Estado: Pendiente"
            android:textColor="#1A1C1E"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_consulta_categoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Categoría: Pendiente de clasificar"
            android:textColor="#1A1C1E"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_consulta_prioridad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Prioridad IA: Pendiente de clasificar"
            android:textColor="#1A1C1E"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_consulta_fecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Fecha de creación:"
            android:textColor="#5F6368"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_consulta_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Tu consulta ha sido enviada correctamente. Cuando esté disponible la clasificación automática, se actualizará la prioridad de triaje."
            android:textColor="#5F6368"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_actualizar_estado"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="32dp"
            android:text="Actualizar estado"
            android:textColor="@android:color/white"
            app:backgroundTint="#4CAF50"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_modificar_consulta"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:text="Modificar consulta"
            android:textColor="@android:color/white"
            app:backgroundTint="#FF9800"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancelar_consulta"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:text="Cancelar consulta"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp"
            app:backgroundTint="#FF0000"
            app:strokeColor="#D32F2F"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_volver_home"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:text="Volver"
            android:textColor="@android:color/white"
            app:backgroundTint="#2196F3"
            app:cornerRadius="12dp" />

    </LinearLayout>

</ScrollView>